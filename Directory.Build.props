<Project>
  <!--
    Shared MSBuild settings, imported automatically by every project under this folder.
    Individual .csproj files only add what is specific to them.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Every project, tests included: a warning is a bug we haven't fixed yet. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Apply the .editorconfig code-style rules (e.g. file-scoped namespaces) during build, not only in the IDE. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
